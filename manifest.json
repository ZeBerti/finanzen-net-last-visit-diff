{
  "manifest_version": 3,
  "name": "Finanzen.net Depot Diff",
  "description": "Extension for finanzen.net to show the diff of your portfolio since last login",
  "version": "0.2.33",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "options.html",
    "default_icon": "logo.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/common.js", "scripts/tableExpansion.js", "scripts/content.js"],
      "matches": [
        "https://www.finanzen.net/depot/*",
        "https://finanzen.net/depot/*",
        "http://localhost/*",
        "file:///Users/*",
        "https://developer.chrome.com/docs/extensions/*",
        "https://developer.chrome.com/docs/webstore/*"
      ]
    }
  ]
}
